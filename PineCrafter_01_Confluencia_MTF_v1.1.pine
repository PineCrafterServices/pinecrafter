//@version=6
// ═══════════════════════════════════════════════════════════════════
//  PineCrafter · Confluencia Multi-Temporalidad / MTF Confluence
//  Portfolio #1 · v1.2 · Pine Script v6 · Sin repintado / Non-repainting
//
//  Qué hace: mira la tendencia en 3 temporalidades a la vez con dos
//  medias exponenciales, la resume en un panel y marca el momento en
//  que las tres se alinean.
//
//  Cómo leerlo:
//   ▲ triángulo cian    = las 3 temporalidades pasan a ser alcistas
//   ▼ triángulo naranja = las 3 temporalidades pasan a ser bajistas
//   Fondo coloreado     = la alineación sigue vigente
//   Panel               = estado de cada temporalidad y puntuación
//
//  IMPORTANTE: usa temporalidades IGUALES O MAYORES que la del gráfico.
//  Las menores se ignoran y el panel las marca con ⚠.
//
//  v1.2 · Idioma por defecto pasa a inglés (para publicar en Fiverr;
//  sigue siendo bilingüe, cambia a español cuando quieras).
//  v1.1 · Colores de señal configurables y distintos de los de las velas,
//         triángulos más grandes, EMAs en tonos discretos.
// ═══════════════════════════════════════════════════════════════════
indicator("PineCrafter · Confluencia Multi-Temporalidad", shorttitle = "PC · MTF", overlay = true)

// ── Idioma / Language ──────────────────────────────────────────────
enum Lang
    es = "Español"
    en = "English"

// ── Grupos de ajustes / Settings groups ────────────────────────────
G_TF    = "Temporalidades / Timeframes"
G_TREND = "Tendencia / Trend"
G_VIS   = "Visual"
G_COL   = "Colores de señal / Signal colors"

// ── Ajustes / Inputs ───────────────────────────────────────────────
tf1     = input.timeframe("60",  "TF 1", group = G_TF)
tf2     = input.timeframe("240", "TF 2", group = G_TF)
tf3     = input.timeframe("D",   "TF 3", group = G_TF)
fastLen = input.int(21, "EMA rápida / Fast EMA", minval = 1, group = G_TREND)
slowLen = input.int(50, "EMA lenta / Slow EMA",  minval = 2, group = G_TREND)
showEma = input.bool(true, "Mostrar EMAs / Show EMAs", group = G_VIS)
showBg  = input.bool(true, "Fondo en confluencia total / Background on full confluence", group = G_VIS)
tblPos  = input.string(position.top_right, "Panel", options = [position.top_right, position.top_left, position.bottom_right, position.bottom_left], group = G_VIS)
langIn  = input.enum(Lang.en, "Idioma / Language", group = G_VIS)

// NUEVO v1.1: colores configurables, por defecto distintos del verde/rojo de las velas
cBull     = input.color(#00E5FF, "Señal alcista / Bullish signal", group = G_COL)
cBear     = input.color(#FF6D00, "Señal bajista / Bearish signal", group = G_COL)
bgOpacity = input.int(88, "Transparencia del fondo / Background transparency", minval = 50, maxval = 99, group = G_COL)

// ── Funciones / Functions ──────────────────────────────────────────
// Devuelve el texto en el idioma elegido
txt(string sEs, string sEn) =>
    langIn == Lang.es ? sEs : sEn

// Estado de tendencia: 1 = alcista, -1 = bajista, 0 = neutral
trendState() =>
    float emaF = ta.ema(close, fastLen)
    float emaS = ta.ema(close, slowLen)
    close > emaS and emaF > emaS ? 1 : close < emaS and emaF < emaS ? -1 : 0

// Etiqueta legible de la temporalidad (60 → 1H, 240 → 4H, D → 1D)
tfLabel(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string lbl = str.contains(tf, "W") or str.contains(tf, "M") ? tf : sec % 86400 == 0 ? str.tostring(int(sec / 86400)) + "D" : sec % 3600 == 0 ? str.tostring(int(sec / 3600)) + "H" : sec % 60 == 0 ? str.tostring(int(sec / 60)) + "m" : str.tostring(sec) + "s"
    lbl

stateText(int s, bool tfBad) =>
    tfBad ? txt("⚠ Menor que el gráfico", "⚠ Below chart TF") : s == 1 ? txt("▲ Alcista", "▲ Bullish") : s == -1 ? txt("▼ Bajista", "▼ Bearish") : txt("■ Neutral", "■ Neutral")

stateColor(int s, bool tfBad) =>
    tfBad ? color.gray : s == 1 ? cBull : s == -1 ? cBear : color.gray

// ── Datos multi-temporalidad SIN repintado ─────────────────────────
// [1] + lookahead_on = usamos siempre la última vela CERRADA de cada
// temporalidad. Lo que ves en el histórico es lo que habrías visto en directo.
int s1 = request.security(syminfo.tickerid, tf1, trendState()[1], lookahead = barmerge.lookahead_on)
int s2 = request.security(syminfo.tickerid, tf2, trendState()[1], lookahead = barmerge.lookahead_on)
int s3 = request.security(syminfo.tickerid, tf3, trendState()[1], lookahead = barmerge.lookahead_on)

// Las temporalidades menores que la del gráfico se ignoran (darían datos engañosos)
int  chartSec = timeframe.in_seconds()
bool bad1     = timeframe.in_seconds(tf1) < chartSec
bool bad2     = timeframe.in_seconds(tf2) < chartSec
bool bad3     = timeframe.in_seconds(tf3) < chartSec

int score    = (bad1 ? 0 : nz(s1)) + (bad2 ? 0 : nz(s2)) + (bad3 ? 0 : nz(s3))
int maxScore = (bad1 ? 0 : 1) + (bad2 ? 0 : 1) + (bad3 ? 0 : 1)

bool fullBull = maxScore > 0 and score == maxScore
bool fullBear = maxScore > 0 and score == -maxScore

// Señal solo al CERRAR la vela y solo cuando la confluencia total empieza
bool longSignal  = barstate.isconfirmed and fullBull and not fullBull[1]
bool shortSignal = barstate.isconfirmed and fullBear and not fullBear[1]

// ── Gráfico / Chart ────────────────────────────────────────────────
float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
// v1.1: EMAs en tonos discretos para que las señales destaquen
plot(showEma ? emaFast : na, "EMA rápida / Fast EMA", color = color.new(#2962FF, 20), linewidth = 1)
plot(showEma ? emaSlow : na, "EMA lenta / Slow EMA",  color = color.new(#787B86, 20), linewidth = 2)

plotshape(longSignal,  title = "Señal alcista / Bullish signal", style = shape.triangleup,   location = location.belowbar, color = cBull, size = size.normal)
plotshape(shortSignal, title = "Señal bajista / Bearish signal", style = shape.triangledown, location = location.abovebar, color = cBear, size = size.normal)

bgcolor(showBg and fullBull ? color.new(cBull, bgOpacity) : showBg and fullBear ? color.new(cBear, bgOpacity) : na, title = "Fondo / Background")

plot(score, "Confluencia / Confluence", display = display.data_window)

// ── Panel ──────────────────────────────────────────────────────────
var table panel = table.new(tblPos, 2, 6, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 70), border_width = 1)

if barstate.islast
    color scoreCol = fullBull ? cBull : fullBear ? cBear : color.gray
    table.cell(panel, 0, 0, "PineCrafter", text_color = color.white, bgcolor = color.new(#2962FF, 30), text_size = size.small)
    table.cell(panel, 1, 0, txt("Confluencia MTF", "MTF Confluence"), text_color = color.white, bgcolor = color.new(#2962FF, 30), text_size = size.small)
    table.cell(panel, 0, 1, txt("Temporalidad", "Timeframe"), text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 1, txt("Tendencia", "Trend"), text_color = color.silver, text_size = size.small)
    table.cell(panel, 0, 2, tfLabel(tf1), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 2, stateText(nz(s1), bad1), text_color = color.white, bgcolor = color.new(stateColor(nz(s1), bad1), 45), text_size = size.small)
    table.cell(panel, 0, 3, tfLabel(tf2), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 3, stateText(nz(s2), bad2), text_color = color.white, bgcolor = color.new(stateColor(nz(s2), bad2), 45), text_size = size.small)
    table.cell(panel, 0, 4, tfLabel(tf3), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 4, stateText(nz(s3), bad3), text_color = color.white, bgcolor = color.new(stateColor(nz(s3), bad3), 45), text_size = size.small)
    table.cell(panel, 0, 5, txt("Confluencia", "Confluence"), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 5, str.tostring(score) + " / " + str.tostring(maxScore), text_color = color.white, bgcolor = color.new(scoreCol, 35), text_size = size.small)

// ── Alertas / Alerts ───────────────────────────────────────────────
alertcondition(longSignal,  "Confluencia alcista / Bullish confluence", "PineCrafter: confluencia alcista total en {{ticker}} ({{interval}})")
alertcondition(shortSignal, "Confluencia bajista / Bearish confluence", "PineCrafter: confluencia bajista total en {{ticker}} ({{interval}})")
